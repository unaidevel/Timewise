# =============================================================================
# Django Core
# =============================================================================
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Europe/Madrid

# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_ENGINE=django.db.backends.postgresql
POSTGRES_DB=timewise
POSTGRES_TEST_DB=timewise_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# POSTGRES_MAINTENANCE_DB=postgres

# =============================================================================
# CORS
# Comma-separated, no trailing slashes. Required when DJANGO_DEBUG=False.
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Accept-Language,Content-Language,Content-Type,Authorization

# =============================================================================
# Rate Limiting
# Set RATE_LIMIT_ENABLED=false to bypass entirely.
# Use redis://... for RATE_LIMIT_STORAGE_URI in multi-process production setups.
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_AUTHENTICATED=1000/hour

# =============================================================================
# Auth
# =============================================================================
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=5
AUTH_MAX_FAILED_ATTEMPTS_PER_ACCOUNT=5
AUTH_MAX_FAILED_ATTEMPTS_PER_IP=20
AUTH_LOCKOUT_WINDOW_MINUTES=15
AUTH_MAX_ACTIVE_SESSIONS_PER_USER=5
# Set AUTH_TRUST_PROXY_HEADERS=true only when running behind a trusted reverse proxy (nginx).
AUTH_TRUST_PROXY_HEADERS=false
AUTH_TRUSTED_PROXIES=
AUTH_LOGIN_ATTEMPT_CLEANUP_PROBABILITY_PCT=1

# =============================================================================
# Production-only Django security headers (only read when DJANGO_DEBUG=false)
# =============================================================================
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true
