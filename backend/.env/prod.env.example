# Production environment for the backend container.
# Copy to prod.env on the server and fill in the real values:
#   cp backend/.env/prod.env.example backend/.env/prod.env
#
# Variables defined here take precedence over the committed *.env files
# (settings.py loads them with os.environ.setdefault).

# --- Django core ---
DJANGO_DEBUG=False
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_ALLOWED_HOSTS=timewise.unaimunoz.dev
DJANGO_TIME_ZONE=Europe/Madrid

# --- CORS / CSRF ---
# Same-origin deploy behind Caddy: the public origin is the HTTPS subdomain.
CORS_ALLOWED_ORIGINS=https://timewise.unaimunoz.dev
DJANGO_CSRF_TRUSTED_ORIGINS=https://timewise.unaimunoz.dev

# --- Security headers (TLS terminated by Caddy) ---
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true

# --- PostgreSQL (db service on the internal compose network) ---
POSTGRES_ENGINE=django.db.backends.postgresql
POSTGRES_DB=timewise
POSTGRES_USER=timewise
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Auth / rate limiting ---
AUTH_MAX_FAILED_ATTEMPTS_PER_ACCOUNT=5
AUTH_MAX_FAILED_ATTEMPTS_PER_IP=20
AUTH_LOCKOUT_WINDOW_MINUTES=15
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=5
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_AUTHENTICATED=1000/hour
