# Root .env read by Docker Compose for variable interpolation.
# Copy to .env on the server: cp .env.example .env
#
# These values configure the `db` (Postgres) container. They MUST match the
# POSTGRES_* values in backend/.env/prod.env so the backend can connect.
POSTGRES_DB=timewise
POSTGRES_USER=timewise
POSTGRES_PASSWORD=CHANGE_ME
