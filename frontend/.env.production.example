# Production .env template for the frontend build.
# Copy to .env.production on the server (or pass as build arg) and rebuild.
#
# IMPORTANT: VITE_API_URL is inlined into the static bundle at `pnpm build`.
# Changing it requires rebuilding the frontend image. It is publicly visible
# in the JS — do not put secrets here.
VITE_API_URL=https://tudominio.com/api
